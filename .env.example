# Required. Server-side only - never prefix with VITE_ (that would ship it to browsers).
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-opus-5-5     # or claude-sonnet-5-5 for lower cost / faster
# ACCESS_CODE=                        # if set, users must enter this code to run analyses
# RATE_LIMIT_PER_HOUR=20              # per-IP, per server instance; 0 disables
# PORT=8787
